# Copy to .env and fill in. NEVER commit the filled-in file.

# --- Banco de dados ---
# Host-side URL. E este o valor usado por tudo que roda FORA do container: prisma migrate,
# prisma db seed, os testes. De dentro do Docker o hostname `postgres` resolve; do Windows,
# nao — de fora e sempre localhost na porta publicada.
#
# O container NAO le esta linha: docker-compose.yml define DATABASE_URL em `environment:`, que
# tem precedencia sobre `env_file:`, e la o valor e `postgres:5432`. Os dois contextos convivem
# sem que um precise ser trocado pelo outro.
DATABASE_URL=postgresql://agrohub:agrohub@localhost:5432/agrohub

# --- Autenticacao ---
# Gere um valor real com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Minimo de 32 caracteres. A aplicacao NAO sobe sem esta variavel e nao existe valor padrao.
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Custo do bcrypt (4-15). Producao: 12.
BCRYPT_COST=12

# --- Rate limiting por origem (FR-021) ---
THROTTLE_TTL=60
THROTTLE_LIMIT=20

# --- Rate limiting do cadastro (FR-021a) ---
# Mais restrito que o limite geral: o 409 de e-mail duplicado permite descobrir quais enderecos
# ja estao cadastrados, e ninguem legitimo cria contas em serie.
REGISTER_THROTTLE_TTL=60
REGISTER_THROTTLE_LIMIT=5

# --- Rate limiting por identificador (FR-020) ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# --- Observabilidade ---
LOG_LEVEL=info
PORT=3000
